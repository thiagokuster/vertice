# ADMIN_PASSWORD="DefinaUmaSenhaForte@123"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Vértice <estoque@localhost>"
