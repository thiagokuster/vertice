DATABASE_URL="file:./dev.db"
# Com mais de um processo, use PostgreSQL. O schema atual é SQLite: troque o provider,
# gere uma migração nova e aponte DATABASE_URL para postgresql://vertice:vertice@localhost:5432/vertice
AUTH_SECRET="troque-por-um-segredo-longo"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"
SEED_DEMO="true"
# Só preencha se um proxy conhecido sobrescrever X-Forwarded-For. Sem isso, o IP do cabeçalho é ignorado.
# TRUSTED_PROXIES="127.0.0.1"
